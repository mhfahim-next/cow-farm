{
  "name": "cow-farm-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests next.config.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test --test-concurrency=1 tests/integration.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.4.0",
    "lucide-react": "0.468.0",
    "sonner": "2.0.7",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@prisma/client": "7.2.0",
    "@prisma/adapter-pg": "7.2.0",
    "pg": "8.16.3",
    "zod": "4.1.13",
    "dotenv": "17.2.3",
    "jsonwebtoken": "9.0.2",
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prettier": "3.6.2",
    "@playwright/test": "1.58.2",
    "prisma": "7.2.0",
    "tsx": "4.21.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.15.6",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3"
  }
}
